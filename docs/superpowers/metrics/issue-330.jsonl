ixture JSON, following the same pattern as backend/__tests__/fixtures/declared-gh-pull-request-reviews.json's \"captured\" key. Verification commands both pass: npm --prefix backend run typecheck (exit 0) and npm --prefix backend test -- __tests__/infrastructure/ct-groom-epic.test.ts __tests__/infrastructure/plan-refusal.test.ts (21 tests, exit 0).","brief_vara_ct_docs":8,"brief_bytes":56926,"agent_bytes":11986,"skill_bytes":18145,"package_bytes":56926,"tool":"claude-code","tool_version":"2.1.270","tool_usage_status":"measured","tool_input_tokens":10,"tool_cached_input_tokens":2110614,"tool_output_tokens":2500,"tool_total_tokens":2113124,"tool_duration_status":"unsupported","tool_active_duration_ms":null,"tool_usage_evidence":["req_011Cf4318yLYfx5op2p8FrRt","req_011Cf431a8vPX4bF7pC8Eqcr","req_011Cf43255TxCXkMBtAi4gWM","req_011Cf433S2KN1Zhhdm1QnpLz","req_011Cf43YvSAge3iyTyntzjU2"],"tool_usage_gaps":0,"tool_account_email":"jponzvan@mercadona.es"}
