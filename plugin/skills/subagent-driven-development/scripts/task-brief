#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# usage: task-brief [--with-plan-context] PLAN_FILE TASK_NUMBER [OUTFILE]
# The flag goes FIRST and is optional. With it, and only with it, the output
# file carries, ahead of the task, the sections "### Desired end state",
# "### Out of scope", "## 2. Closed decisions" and "## 3. Reference patterns",
# each under its own heading.
#
# THE FOUR SECTIONS DO NOT CARRY THE SAME AUTHORITY, and that is why they go
# under two different lines. The last three are the YARDSTICK: if they
# contradict the task, they win. "### Desired end state" is not — it is the
# slice's end, and it travels so that whoever implements and whoever judges
# know what the task serves, which was the only thing tying the task to the
# issue's acceptance criteria and it was not arriving. Giving it yardstick
# authority would be a licence to widen the task ("it serves the slice's end"),
# and that weakens precisely the `alcance` item, which works today.
# Without the flag the output is the same as always, byte for byte: the default
# path of subagent-driven-development calls this script and that decision is
# José's.
#
# Default OUTFILE: <repo-root>/.superpowers/sdd/task-<N>-brief.md
# (per worktree; concurrent runs in the same working tree share it).
set -euo pipefail

with_plan_context=0
if [ $# -ge 1 ] && [ "$1" = "--with-plan-context" ]; then
  with_plan_context=1
  shift
elif [ $# -ge 1 ] && [[ "$1" == --* ]]; then
  echo "usage: task-brief [--with-plan-context] PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/task-${n}-brief.md"
fi

# Extracts a section by its literal heading (with its "#" level), up to the
# next heading of equal or lower level, respecting code fences so that a
# "# ..." comment inside a block is not mistaken for a real heading.
extract_section() {
  local heading=$1
  awk -v hdr="$heading" '
    function heading_level(s) { match(s, /^#+/); return RLENGTH }
    BEGIN { hlvl = heading_level(hdr) }
    /^```/ { infence = !infence }
    !infence && !found && index($0, hdr) == 1 { found = 1; insec = 1; print; next }
    insec && !infence && $0 ~ /^#+[ \t]/ {
      lvl = heading_level($0)
      if (lvl <= hlvl) { insec = 0 }
    }
    insec { print }
  ' "$plan"
}

# Wraps extract_section: if the plan does not carry that section, a blank gap
# reads as "it exists and it is empty", which is not the same as "it does not
# exist" — and the line above already says these sections are the yardstick.
# Declaring it absent is the only thing that does not lie.
print_section() {
  local heading=$1
  local contenido
  contenido=$(extract_section "$heading")
  if [ -z "$contenido" ]; then
    echo "(sección '${heading}' no encontrada en el plan)"
  else
    printf '%s\n' "$contenido"
  fi
}

task_tmp=$(mktemp)
trap 'rm -f "$task_tmp"' EXIT

awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
  }
  intask { print }
' "$plan" > "$task_tmp"

if [ ! -s "$task_tmp" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

if [ "$with_plan_context" -eq 1 ]; then
  {
    echo "> El fin del slice, para situar esta tarea en él. NO es vara: no amplía el"
    echo "> **Files:** de la tarea ni lo que ésta declara fuera de alcance, y una tarea que"
    echo "> sirve al fin del slice haciendo algo que su texto no pide sigue estando fuera."
    echo
    print_section "### Desired end state"
    echo
    echo "> Estas secciones son la vara del plan: si contradicen la tarea, ganan ellas."
    echo
    print_section "### Out of scope"
    echo
    print_section "## 2. Closed decisions"
    echo
    print_section "## 3. Reference patterns"
    echo
    cat "$task_tmp"
  } > "$out"
else
  cat "$task_tmp" > "$out"
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
