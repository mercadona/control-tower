#!/usr/bin/env node
// Stub of `gh` for tests: it NEVER touches the network nor any real
// repository. Driven entirely by environment variables so that the tests in
// dispatch-check-dryrun.test.js can simulate `gh` failures (auth, rate limit,
// network) at specific points of the claim sequence without calling the real
// `gh`. See that test file for the use of each variable.
import { readFileSync, writeFileSync, existsSync, appendFileSync } from 'node:fs'
import { waitForReleaseFile } from '../stub-wait.js'

const argv = process.argv.slice(2)
const joined = argv.join(' ')

// FAKE_GH_ARGV_LOG_FILE (final review, finding 2): records the exact argv of
// every invocation so that the tests can check that the enumeration of issues
// uses `--paginate` (real pagination) and NEVER `--limit` (the fixed cap that
// reintroduces the silent truncation bug) — without this there is no way to
// tell, from a stub that ignores the flags, whether the real command would
// still be truncating against the real GitHub.
if (process.env.FAKE_GH_ARGV_LOG_FILE) {
  appendFileSync(process.env.FAKE_GH_ARGV_LOG_FILE, joined + '\n')
}

function nextCallIndex(counterFile) {
  if (!counterFile) return 0
  let n = 0
  if (existsSync(counterFile)) n = parseInt(readFileSync(counterFile, 'utf8'), 10) || 0
  writeFileSync(counterFile, String(n + 1))
  return n
}

// FAKE_GH_LIST_SEQUENCE_FILE (D2 review, minor 4/maxBuffer): reads the sequence
// from a FILE instead of the inline content of FAKE_GH_LIST_SEQUENCE —
// necessary to reproduce a response of several MiB (e.g. a collision with
// thousands of issues in flight) without passing it through an environment
// variable: on macOS ARG_MAX (`getconf ARG_MAX`) is ~1 MiB for the whole
// argv+environ combined, so a single env var of several MiB blows up the test's
// own `spawnSync` outright (it does not even get to run the child). A file, on
// the other hand, has no such limit — only the PATH travels through env. If it
// is not defined, FAKE_GH_LIST_SEQUENCE keeps being read inline as before (no
// change of default behaviour).
function loadSequence() {
  if (process.env.FAKE_GH_LIST_SEQUENCE_FILE) {
    return JSON.parse(readFileSync(process.env.FAKE_GH_LIST_SEQUENCE_FILE, 'utf8'))
  }
  return JSON.parse(process.env.FAKE_GH_LIST_SEQUENCE || '[[]]')
}

// main(): ALL the dispatch logic lives here, with `return` instead of
// `process.exit(N)` in every branch (D2 review, minor 4 — a collateral finding
// while building the maxBuffer test): `process.stdout`/`process.stderr` are
// ASYNCHRONOUS towards a pipe on POSIX (documented explicitly in Node's own
// docs: "Pipes (and sockets): asynchronous on POSIX"), which is exactly how
// execFileSync connects with this script. `process.exit(N)` ends the process
// NOW, without waiting for a large in-flight `write()` to finish draining — a
// payload of several MiB (like the one a real test of ct-next.mjs's `maxBuffer`
// demands) is silently truncated to a multiple of the size of the OS pipe
// buffer (64 KiB on this Mac), regardless of any `maxBuffer` the READING SIDE
// may set. Verified by construction: with the old version (`process.exit()`
// immediately after the `write`), a payload of ~11 MB of JSON arrived truncated
// to 64 KiB on the other side. Setting `process.exitCode` and letting the
// script end on its own (with no `process.exit()`) lets Node drain the pipe
// before really exiting — see the variant of this very experiment in
// /private/tmp/.../node-repro/parent-nobuf.js vs parent-withbuf.js. This is
// purely a property of the STUB (it never touched the real `gh` nor
// dispatch-check.mjs/ct-next.mjs), so it changes the behaviour of NO existing
// test with small payloads — it only makes the large-payload case correct
// (instead of "it works by accident because it was never tried with anything
// big"). (D1+D2: the same `return`-instead-of-`exit` now applies as well to the
// milestones/label-create blocks that D1 (`fix/dispatch-graph-hardening`) added
// for F5/ct-groom.mjs — they had no reason to stay out of this protection just
// for coming from the other branch.)
function main() {
  if (argv[0] === 'issue' && argv[1] === 'edit') {
    // FAKE_GH_EDIT_WAIT_FILE (F8): it stays INSIDE this `issue edit` until the
    // test creates the sentinel file. It replaces the time window of
    // FAKE_GH_EDIT_DELAY_MS in the tests that need to send a signal "while the
    // claim is being written": the argv was already recorded above
    // (appendFileSync, synchronous), so the test can detect by file that we are
    // in here, send the signal at its leisure, and only then let us go. See
    // __tests__/fixtures/stub-wait.js for the full reasoning.
    //
    // MIND THE SCOPE: this blocks EVERY `issue edit`, the later automatic
    // revert included. That is intentional and it does no harm — by the time
    // ct-next reaches the revert, the sentinel has existed for a good while and
    // the wait is a no-op.
    waitForReleaseFile('FAKE_GH_EDIT_WAIT_FILE')
    // FAKE_GH_EDIT_DELAY_MS (finding 1, signal re-entry test): deterministically
    // widens the window in which ct-next.mjs is blocked INSIDE the automatic
    // revert itself (gh() is a synchronous call) — needed in order to send a
    // SECOND signal while the first is still being handled, without depending on
    // winning a race against the OS scheduler under variable load. Synchronous
    // on purpose (this is the CHILD simulating gh's real latency, not
    // ct-next.mjs itself).
    const delayMs = Number(process.env.FAKE_GH_EDIT_DELAY_MS || 0)
    if (delayMs > 0) {
      const sab = new Int32Array(new SharedArrayBuffer(4))
      Atomics.wait(sab, 0, 0, delayMs)
    }
    const failSubstr = process.env.FAKE_GH_EDIT_FAIL_SUBSTR
    if (failSubstr && joined.includes(failSubstr)) {
      console.error('fake-gh: issue edit failed (simulado)')
      process.exitCode = 1
      return
    }
    process.exitCode = 0
    return
  }

  // `gh issue create --repo <r> --title … --body … --milestone … --label …`
  // (ct-groom.mjs). It returns on stdout the URL of the created issue, which is
  // what gh really prints and what ct-groom.mjs then passes to `gh project
  // item-add --url`. F6: until now NO CLI test reached this branch — every real
  // run test of ct-groom started from issues that already existed, so the
  // CREATION path (the most common one in production: grooming a new epic) was
  // never exercised in the suite. It numbers from 900 so that no created number
  // can be confused with the fixtures of existing issues (501/502…).
  if (argv[0] === 'issue' && argv[1] === 'create') {
    if (process.env.FAKE_GH_ISSUE_CREATE_FAIL) {
      console.error('fake-gh: issue create failed (simulado)')
      process.exitCode = 1
      return
    }
    const n = nextCallIndex(process.env.FAKE_GH_CREATE_COUNTER_FILE)
    process.stdout.write(`https://github.com/o/r/issues/${900 + n}\n`)
    process.exitCode = 0
    return
  }

  // `issue comment` — used by the `-OK` watcher to explain the format when
  // someone tries to give the go and their comment does not open it. The body
  // goes to the argv log (FAKE_GH_ARGV_LOG_FILE), which is where the test reads
  // it: what has to be checkable is that that body does NOT carry the nonce.
  if (argv[0] === 'issue' && argv[1] === 'comment') {
    if (process.env.FAKE_GH_ISSUE_COMMENT_FAIL) {
      console.error('fake-gh: issue comment failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write('https://github.com/o/r/issues/5#issuecomment-1\n')
    process.exitCode = 0
    return
  }

  if (argv[0] === 'issue' && argv[1] === 'view') {
    // FAKE_GH_VIEW_FAIL (D2, finding 3): simulates `labelsOf()` (the read of
    // the candidate's own labels in dispatch-check.mjs) failing — auth down,
    // rate limit, network — BEFORE any write. Without this there was no way to
    // tell apart, from a stub, "the state of the candidate could not be read"
    // (an infrastructure failure) from "collision detected" (a normal outcome
    // of the protocol): both cases, before this fix, ended in the same exit 1
    // of dispatch-check that ct-next always treated as "skip and carry on".
    // FAKE_GH_VIEW_FAIL_AT (D2 review, minor 3): an indexed variant of
    // FAKE_GH_VIEW_FAIL — it fails only the Nth call to `issue view` (0-based,
    // with its OWN counter via FAKE_GH_VIEW_COUNTER_FILE, independent of the
    // FAKE_GH_LIST_SEQUENCE counter) instead of ALL of them. Necessary to test
    // that an infrastructure failure on ONE candidate of the batch does not
    // prevent trying the NEXT one — with FAKE_GH_VIEW_FAIL (no index) both
    // would fail alike and there would be no telling "it aborts the whole
    // batch" from "it carries on with the rest".
    const viewCallIndex = nextCallIndex(process.env.FAKE_GH_VIEW_COUNTER_FILE)
    const viewFailAt = process.env.FAKE_GH_VIEW_FAIL_AT !== undefined ? Number(process.env.FAKE_GH_VIEW_FAIL_AT) : null
    if (process.env.FAKE_GH_VIEW_FAIL || (viewFailAt !== null && viewCallIndex === viewFailAt)) {
      console.error('fake-gh: issue view failed (simulado)')
      process.exitCode = 1
      return
    }
    // FAKE_GH_VIEW_COMMENTS — the `--json comments` path, which is the one the
    // `-OK` watcher uses (scripts/ct-watch-go.mjs). It goes apart from the
    // labels one because they are two different questions to the same
    // subcommand: without separating them, the watcher would receive the list
    // of labels and would never find `comments` in it.
    //
    // FAKE_GH_VIEW_COMMENTS_SEQUENCE (optional) is a list of payloads, one per
    // call, so that what really matters about the watcher can be tested: that
    // on the first tick there is NO go and it keeps waiting, and that on a
    // LATER tick there is one and then it pushes. With a fixed payload only one
    // of the two can be tested.
    if (joined.includes('--json comments')) {
      // FAKE_GH_VIEW_COMMENTS_FAIL (F38): fails ONLY the read of comments, not
      // the one of labels nor the one of the body. With FAKE_GH_VIEW_FAIL
      // (which brings down every `issue view`) door 9 of `--release` cannot be
      // tested: door 8, which reads the body, wins first and the test would be
      // measuring something else.
      if (process.env.FAKE_GH_VIEW_COMMENTS_FAIL) {
        console.error('fake-gh: issue view --json comments failed (simulado)')
        process.exitCode = 1
        return
      }
      const seq = process.env.FAKE_GH_VIEW_COMMENTS_SEQUENCE
        ? JSON.parse(process.env.FAKE_GH_VIEW_COMMENTS_SEQUENCE)
        : null
      if (seq) {
        const i = nextCallIndex(process.env.FAKE_GH_VIEW_COMMENTS_COUNTER_FILE)
        process.stdout.write(JSON.stringify(seq[Math.min(i, seq.length - 1)]))
      } else {
        process.stdout.write(process.env.FAKE_GH_VIEW_COMMENTS || '{"comments":[]}')
      }
      process.exitCode = 0
      return
    }
    // FAKE_GH_VIEW_BODY (TASK 10) — the `--json body` path, which is the one
    // the F-e2e door of `dispatch-check.mjs --release` uses to read the body of
    // the issue and cross it against the delivered run. It goes apart from the
    // labels one and the comments one for the same reason as they do: same
    // subcommand, different question — without separating it, the F-e2e door
    // would receive the list of labels and would never find a body to parse.
    if (joined.includes('--json body')) {
      process.stdout.write(process.env.FAKE_GH_VIEW_BODY ?? '')
      process.exitCode = 0
      return
    }
    // FAKE_GH_ISSUE_VIEW_JSON (F20/harvest, Task 6) — the `--json
    // number,title,state,closedAt,labels,milestone,closedByPullRequestsReferences`
    // path, which is the whole row of the slice that `SliceHarvest` reads in
    // `--collect`. It goes apart from labels/comments/body for the same reason
    // as they do: same subcommand, different question.
    if (joined.includes('--json number,title')) {
      process.stdout.write(process.env.FAKE_GH_ISSUE_VIEW_JSON || '{}')
      process.exitCode = 0
      return
    }
    process.stdout.write(process.env.FAKE_GH_VIEW_LABELS || '[]')
    process.exitCode = 0
    return
  }

  if (argv[0] === 'issue' && argv[1] === 'list') {
    const callIndex = nextCallIndex(process.env.FAKE_GH_COUNTER_FILE)
    const failAt = process.env.FAKE_GH_LIST_FAIL_AT !== undefined ? Number(process.env.FAKE_GH_LIST_FAIL_AT) : null
    if (failAt !== null && callIndex === failAt) {
      console.error('fake-gh: issue list failed (simulado)')
      process.exitCode = 1
      return
    }
    const seq = loadSequence()
    const out = seq[Math.min(callIndex, seq.length - 1)]
    process.stdout.write(JSON.stringify(out))
    process.exitCode = 0
    return
  }

  // `gh api repos/<owner>/<repo>/issues ... --paginate --slurp` (final review,
  // finding 2): ct-next.mjs and dispatch-check.mjs enumerate open/closed issues
  // through this REST endpoint instead of `gh issue list --limit N`, so as not
  // to reintroduce the silent truncation. It reuses EXACTLY the same
  // counter-based sequencing as the `issue list` block above, so that the
  // existing tests (which already orchestrate one "open" call followed by one
  // "closed"/readback call via FAKE_GH_LIST_SEQUENCE) keep working unchanged
  // after the change of the underlying command.
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/issues$/.test(argv[1] || '')) {
    const callIndex = nextCallIndex(process.env.FAKE_GH_COUNTER_FILE)
    const failAt = process.env.FAKE_GH_LIST_FAIL_AT !== undefined ? Number(process.env.FAKE_GH_LIST_FAIL_AT) : null
    if (failAt !== null && callIndex === failAt) {
      console.error('fake-gh: api issues failed (simulado)')
      process.exitCode = 1
      return
    }
    const seq = loadSequence()
    const out = seq[Math.min(callIndex, seq.length - 1)]
    process.stdout.write(JSON.stringify(out))
    process.exitCode = 0
    return
  }

  // `gh api repos/<owner>/<repo>/issues/<n>/timeline --paginate`
  // (ct-status.mjs, F25): the timeline of ONE issue, which is where the AGE of
  // the claim comes from — the most recent `labeled` event for
  // `status:in-progress`. Without that age there is no telling a slice that has
  // just started (still with no `claude` process, and perfectly healthy) from
  // one abandoned three hours ago.
  //
  // FAKE_GH_TIMELINE_JSON is the complete response, as is (`--paginate` over an
  // array endpoint returns ONE already merged array, not an array of pages: it
  // carries no `--slurp`). The default "[]" —a timeline with no event at all—
  // is deliberate and is the "the age could not be determined" case: no
  // pre-existing test reaches here, and those that do reach it without setting
  // the variable must not receive an invented age.
  // FAKE_GH_TIMELINE_FAIL simulates the read failing (auth/network/rate limit),
  // which is the case in which the command can NOT accuse anyone of
  // abandonment.
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/issues\/\d+\/timeline$/.test(argv[1] || '')) {
    if (process.env.FAKE_GH_TIMELINE_FAIL) {
      console.error('fake-gh: api issue timeline failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(process.env.FAKE_GH_TIMELINE_JSON || '[]')
    process.exitCode = 0
    return
  }

  // `gh api repos/<owner>/<repo>/milestones ...` (ct-groom.mjs, F5): the
  // listing (explicit GET, `--method GET -f state=all --paginate`) and the
  // creation (implicit POST, with no `--method`, only `-f title=<t>`) share the
  // same REST endpoint — they are told apart by the presence of `--method` in
  // argv (the listing ALWAYS passes it explicitly; the creation never does).
  // FAKE_GH_MILESTONES_LIST drives the response of the listing (default: "[]",
  // no existing milestone); FAKE_GH_MILESTONE_CREATE_NUMBER drives the number
  // returned when "creating" one (default: 1). The F5 tests (divergence
  // detection / --reconcile) always take for granted a milestone that ALREADY
  // exists and matches the title of the plan, precisely so as not to have to
  // exercise the creation branch — it is an orthogonal feature, already wired
  // up and with no CLI tests of its own before F5.
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/milestones$/.test(argv[1] || '')) {
    if (argv.includes('--method')) {
      process.stdout.write(process.env.FAKE_GH_MILESTONES_LIST || '[]')
      process.exitCode = 0
      return
    }
    process.stdout.write(JSON.stringify({ number: Number(process.env.FAKE_GH_MILESTONE_CREATE_NUMBER || 1) }))
    process.exitCode = 0
    return
  }

  // `gh api repos/<owner>/<repo>/labels --method GET --paginate --slurp`
  // (ct-groom.mjs, F6 minor 5): the labels that ALREADY exist in the
  // repository, so as to be able to tell "I reused one" from "I invented a new
  // one" and so as not to rewrite with --force the ones that were already
  // there. FAKE_GH_LABELS_LIST brings the response ALREADY in --slurp form (an
  // array of pages: [[{name},…]]); the default is "[[]]" (a repository with no
  // label at all), which is the right thing for the tests older than F6 — with
  // it, every label of the plan comes out as "newly created", just as the
  // unconditional `--force` of before did.
  // FAKE_GH_LABELS_FAIL simulates the listing failing (auth/network/rate
  // limit).
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/labels$/.test(argv[1] || '')) {
    if (process.env.FAKE_GH_LABELS_FAIL) {
      console.error('fake-gh: api labels failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(process.env.FAKE_GH_LABELS_LIST || '[[]]')
    process.exitCode = 0
    return
  }

  // `gh api repos/<o>/<r>/contents/docs/superpowers/metrics[...]`
  // (ct-harvest.mjs, §3.4): the LISTING of the telemetry directory and the RAW
  // read of a file. It goes before the generic `contents/` branch (the one of
  // ct-groom's spec rendered as HTML) because that one matches any path.
  //
  // Without FAKE_GH_METRICS_DIR_JSON the listing FAILS, which is the real life
  // of every repository older than the judge's telemetry: the default cannot be
  // an invented empty directory.
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/contents\/docs\/superpowers\/metrics/.test(argv[1] || '')) {
    const ruta = argv[1]
    const esDirectorio = /\/contents\/docs\/superpowers\/metrics$/.test(ruta)
    if (esDirectorio) {
      if (!process.env.FAKE_GH_METRICS_DIR_JSON) {
        console.error('fake-gh: api contents (metrics dir) failed (simulado: 404 Not Found)')
        process.exitCode = 1
        return
      }
      process.stdout.write(process.env.FAKE_GH_METRICS_DIR_JSON)
      process.exitCode = 0
      return
    }
    const fallo = process.env.FAKE_GH_METRICS_FILE_FAIL
    if (fallo && ruta.includes(fallo)) {
      console.error('fake-gh: api contents (metrics file) failed (simulado)')
      process.exitCode = 1
      return
    }
    const ficheros = JSON.parse(process.env.FAKE_GH_METRICS_FILES || '{}')
    const nombre = ruta.split('/').pop()
    if (!Object.hasOwn(ficheros, nombre)) {
      console.error('fake-gh: api contents (metrics file) 404 (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(ficheros[nombre])
    process.exitCode = 0
    return
  }

  // `gh api repos/<o>/<r>/contents/<path>?ref=<branch> -H "Accept:
  // application/vnd.github.html"` (ct-groom.mjs, F10): the spec RENDERED by
  // GitHub. ct-groom.mjs asks for it for two things at once — that the file
  // really does exist on that branch (if it does not, there is no link to
  // write) and that the anchor it has computed from the heading really is in
  // the HTML.
  //
  // FAKE_GH_CONTENTS_FAIL simulates the 404 of the most common case in real
  // life: the spec written but not pushed yet.
  // FAKE_GH_CONTENTS_ANCHORS is the list (space separated) of anchors the
  // published document "has". The default covers the two §9 headings the specs
  // of this suite use ("## 9. Slices" -> "9-slices" and "## 9. Algo" ->
  // "9-algo"); a test that wants to exercise "the anchor is not in the
  // published copy" sets it to something else (or to empty).
  //
  // The HTML is deliberately minimal and WRITTEN BY HAND, not generated with
  // scripts/anchor.js: if the stub computed the anchor with the same code that
  // produces it, the test would be checking nothing. The shape (`<a
  // id="user-content-…" class="anchor">`) is the real one, copied from a GitHub
  // response.
  if (argv[0] === 'api' && /^repos\/[^/]+\/[^/]+\/contents\//.test(argv[1] || '')) {
    if (process.env.FAKE_GH_CONTENTS_FAIL) {
      console.error('fake-gh: api contents failed (simulado: 404 Not Found)')
      process.exitCode = 1
      return
    }
    const anchors = (process.env.FAKE_GH_CONTENTS_ANCHORS ?? '9-slices 9-algo').split(/\s+/).filter(Boolean)
    const body = anchors.map((a) => `<div class="markdown-heading"><h2 class="heading-element">x</h2><a id="user-content-${a}" class="anchor" href="#${a}"></a></div>`).join('\n')
    process.stdout.write(`<div id="file" class="md"><article class="markdown-body">\n${body}\n</article></div>`)
    process.exitCode = 0
    return
  }

  // ---- Project v2 (ct-groom.mjs --project) --------------------------------
  // F15/H2: until now the stub supported NO `project` call at all, so every
  // test with --project died in "unsupported command" — that is, the only way
  // to exercise --project was for it to fail. Without being able to simulate a
  // HEALTHY project there is no checking the ORDER of the mutations (which is
  // what H2 puts in the contract), only the error path.
  //
  //   FAKE_GH_PROJECT_VIEW_FAIL   → `gh project view` fails (project missing/auth).
  //   FAKE_GH_PROJECT_FIELDS      → JSON of `data.node.fields.nodes` for the fields
  //                                 query. Default: a "Sprint" field with an iteration
  //                                 starting TODAY and lasting 14 days (that is, current).
  //                                 `[]` simulates "there is no Sprint field"; a Sprint
  //                                 with an old iteration simulates "no iteration covers
  //                                 today".
  //   FAKE_GH_PROJECT_ITEMS       → JSON of `.items` for `project item-list` (default []).
  if (argv[0] === 'project' && argv[1] === 'view') {
    if (process.env.FAKE_GH_PROJECT_VIEW_FAIL) {
      console.error('fake-gh: project view failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(JSON.stringify({ id: 'PVT_fake' }))
    process.exitCode = 0
    return
  }
  if (argv[0] === 'project' && argv[1] === 'item-list') {
    // F18/H6: the stub honours `--limit` and returns `totalCount`, like the
    // real gh (verified against gh 2.86 over a real project: `--limit 2` over 3
    // items returns `items.length = 2, totalCount = 3`). Before, it ALWAYS
    // returned the whole list and with no `totalCount`, so the truncation —the
    // failure that produces duplicates in the Project— was literally
    // unsimulatable from the tests.
    // FAKE_GH_PROJECT_ITEMS_NO_TOTALCOUNT simulates a version of gh that does
    // not expose it.
    const all = JSON.parse(process.env.FAKE_GH_PROJECT_ITEMS || '[]')
    const li = argv.indexOf('--limit')
    const limit = li >= 0 ? Number(argv[li + 1]) : 30
    const payload = { items: all.slice(0, Number.isFinite(limit) ? limit : all.length) }
    if (!process.env.FAKE_GH_PROJECT_ITEMS_NO_TOTALCOUNT) payload.totalCount = all.length
    process.stdout.write(JSON.stringify(payload))
    process.exitCode = 0
    return
  }
  if (argv[0] === 'project' && argv[1] === 'item-add') {
    process.stdout.write(JSON.stringify({ id: 'PVTI_fake' }))
    process.exitCode = 0
    return
  }
  if (argv[0] === 'api' && argv[1] === 'graphql') {
    // The issue listing of /ct-groom (GROOM_ISSUES_QUERY). It is recognised by
    // `states:[OPEN,CLOSED]`, unique to that query. It translates the SAME
    // FAKE_GH_LIST_SEQUENCE that the REST `issues` branch served into the
    // GraphQL shape (`--paginate --slurp` = an array of response objects, one
    // per page), FILTERING OUT the items with `pull_request` — the real server
    // never returns those through the issues connection, and that is precisely
    // the point of the fix.
    // FAKE_GH_GRAPHQL_PAGE_SIZE splits the response into several pages to test
    // that the pagination loses no issues (review #45, point 4).
    if (joined.includes('states:[OPEN,CLOSED]') || joined.includes('states: [OPEN, CLOSED]')) {
      const callIndex = nextCallIndex(process.env.FAKE_GH_COUNTER_FILE)
      const failAt = process.env.FAKE_GH_LIST_FAIL_AT !== undefined ? Number(process.env.FAKE_GH_LIST_FAIL_AT) : null
      if (failAt !== null && callIndex === failAt) {
        console.error('fake-gh: api graphql issues failed (simulado)')
        process.exitCode = 1
        return
      }
      const seq = loadSequence()
      // The sequence entry may come as a flat list of issues or as an
      // array-of-pages (`[[...],[...]]`), just as the REST branch served it
      // —which ct-groom flattened with flattenIssuePages—. It is flattened here
      // (.flat(), same depth) so as to accept both shapes without touching the
      // fixtures.
      const flat = (seq[Math.min(callIndex, seq.length - 1)] || []).flat()
      const issues = flat.filter((e) => !(e && Object.prototype.hasOwnProperty.call(e, 'pull_request')))
      const toNode = (i) => ({
        number: i.number,
        title: i.title,
        body: i.body,
        state: typeof i.state === 'string' ? i.state.toUpperCase() : i.state,
        milestone: i.milestone ? { title: i.milestone.title } : null,
        labels: { nodes: (i.labels || []).map((l) => ({ name: typeof l === 'string' ? l : l.name })) },
      })
      const size = process.env.FAKE_GH_GRAPHQL_PAGE_SIZE ? Math.max(1, Number(process.env.FAKE_GH_GRAPHQL_PAGE_SIZE)) : Math.max(1, issues.length)
      const pages = []
      for (let i = 0; i < issues.length; i += size) {
        const chunk = issues.slice(i, i + size)
        pages.push({ data: { repository: { issues: { nodes: chunk.map(toNode), pageInfo: { hasNextPage: i + size < issues.length, endCursor: `c${i}` } } } } })
      }
      if (pages.length === 0) pages.push({ data: { repository: { issues: { nodes: [], pageInfo: { hasNextPage: false, endCursor: null } } } } })
      process.stdout.write(JSON.stringify(pages))
      process.exitCode = 0
      return
    }
    // F18/H1+H4: the CLOSURES query of ct-next.mjs (who closed each already
    // satisfied dep, and whether the feat/<n> branch of an in-review one is
    // merged). It is recognised by the kind of timeline item it asks for, which
    // no other query of the plugin uses.
    //
    // The DEFAULT is deliberate: `{"data":{"repository":{}}}`, that is "no
    // alias came back" → everything stays as 'unknown' and NO warning is
    // emitted. Without that default, every pre-existing test that reaches here
    // (the ones that really enumerate issues with FAKE_GH_LIST_SEQUENCE) would
    // start seeing new warnings it never asked for.
    //   FAKE_GH_CLOSURE_JSON → the complete response, as is.
    //   FAKE_GH_CLOSURE_FAIL → the query fails (network/auth/rate limit).
    if (joined.includes('CLOSED_EVENT') || joined.includes('headRefName')) {
      if (process.env.FAKE_GH_CLOSURE_FAIL) {
        console.error('fake-gh: api graphql (cierres) failed (simulado)')
        process.exitCode = 1
        return
      }
      process.stdout.write(process.env.FAKE_GH_CLOSURE_JSON || '{"data":{"repository":{}}}')
      process.exitCode = 0
      return
    }
    // Fields query vs iteration mutation: they are told apart by the text of
    // the query itself, just as ct-groom.mjs emits them.
    const isFieldsQuery = joined.includes('ProjectV2IterationField')
    if (!isFieldsQuery) {
      process.stdout.write(JSON.stringify({ data: { updateProjectV2ItemFieldValue: { projectV2Item: { id: 'PVTI_fake' } } } }))
      process.exitCode = 0
      return
    }
    let nodes
    if (process.env.FAKE_GH_PROJECT_FIELDS) {
      nodes = JSON.parse(process.env.FAKE_GH_PROJECT_FIELDS)
    } else {
      const today = new Date().toISOString().slice(0, 10)
      nodes = [{ id: 'PVTIF_fake', name: 'Sprint', configuration: { iterations: [{ id: 'ITER_fake', title: 'Sprint actual', startDate: today, duration: 14 }] } }]
    }
    // F18/H6: `totalCount` here too — `fields(first: 50)` is a bounded read,
    // and without this datum ct-groom cannot tell "this project has no Sprint
    // field" from "I have not seen all of its fields".
    // FAKE_GH_PROJECT_FIELDS_TOTALCOUNT forces a total greater than what is
    // returned.
    const totalCount = process.env.FAKE_GH_PROJECT_FIELDS_TOTALCOUNT !== undefined
      ? Number(process.env.FAKE_GH_PROJECT_FIELDS_TOTALCOUNT)
      : nodes.length
    process.stdout.write(JSON.stringify({ data: { node: { fields: { totalCount, nodes } } } }))
    process.exitCode = 0
    return
  }

  // `gh label create <name> --repo <repo> --force` (ct-groom.mjs): one call
  // per distinct label the plan produces AND that the repository did not
  // already have (F6), before creating or updating any issue. Always a success
  // — no existing test needs to simulate it failing (label create with --force
  // has, in practice, no "it already exists" case to treat as an error).
  if (argv[0] === 'label' && argv[1] === 'create') {
    process.exitCode = 0
    return
  }

  // `gh repo view <repo> --json defaultBranchRef -q .defaultBranchRef.name`
  // (W-D): ct-next.mjs resolves the real default branch of the repository
  // instead of blindly assuming "main". FAKE_GH_DEFAULT_BRANCH drives the value
  // returned (default: "main", so that the existing tests that do not set this
  // variable — and that do not care which base branch is used — keep passing
  // unchanged). FAKE_GH_REPO_VIEW_FAIL simulates gh not being able to resolve
  // it (repository not found, auth down, no network, etc.).
  //
  // Fix round 1, Minor 3 (W-D review): `??` instead of `||` — with `||`,
  // setting FAKE_GH_DEFAULT_BRANCH to the empty string ('') still fell back to
  // 'main' ('' is falsy), so the "gh repo view returned nothing" branch of
  // detectDefaultBranch in ct-next.mjs was untestable with this stub. `??`
  // falls back to the default only when the variable is not defined at all — an
  // explicit empty string propagates as is, really reaching that branch.
  if (argv[0] === 'repo' && argv[1] === 'view') {
    if (process.env.FAKE_GH_REPO_VIEW_FAIL) {
      console.error('fake-gh: repo view failed (simulado)')
      process.exitCode = 1
      return
    }
    process.stdout.write(`${process.env.FAKE_GH_DEFAULT_BRANCH ?? 'main'}\n`)
    process.exitCode = 0
    return
  }

  // `gh pr list --repo <r> --head feat/<n> --state merged --json number,mergedAt`
  // (ct-watch-merge.mjs): the merge watcher's only question. The branch of a
  // slice is deterministic (`feat/<n>`), so "is it merged?" needs no heuristic
  // at all — it comes straight out of `gh`.
  //
  // FAKE_GH_PR_LIST is the fixed payload (default: `[]`, no merged PR, which is
  // the state in which the watcher starts waiting).
  // FAKE_GH_PR_LIST_SEQUENCE is a list of payloads, one per call, with its own
  // counter in FAKE_GH_PR_LIST_COUNTER_FILE — necessary for the case that
  // really matters: the first polls see nothing and a later one does, which is
  // how a merge looks in the real world. The last entry repeats once the
  // sequence runs out, so that the watcher can keep polling without the stub
  // running out of answers.
  // FAKE_GH_PR_LIST_FAIL simulates the read failing (network down, an expired
  // token, a 502): what this stub has to be able to exercise is that a
  // transient failure is NOT read as "it is not merged" permanently.
  if (argv[0] === 'pr' && argv[1] === 'list') {
    if (process.env.FAKE_GH_PR_LIST_FAIL) {
      console.error('fake-gh: pr list failed (simulado)')
      process.exitCode = 1
      return
    }
    if (process.env.FAKE_GH_PR_LIST_SEQUENCE) {
      const seq = JSON.parse(process.env.FAKE_GH_PR_LIST_SEQUENCE)
      const i = nextCallIndex(process.env.FAKE_GH_PR_LIST_COUNTER_FILE)
      process.stdout.write(JSON.stringify(seq[Math.min(i, seq.length - 1)] ?? []))
      process.exitCode = 0
      return
    }
    process.stdout.write(process.env.FAKE_GH_PR_LIST || '[]')
    process.exitCode = 0
    return
  }

  console.error(`fake-gh: comando no soportado en el stub: ${joined}`)
  process.exitCode = 1
}

main()
