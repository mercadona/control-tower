#!/bin/sh
# `claude` exactly as the login shell that cmux opens would see it (F19/H1).
#
# NOT to be confused with __tests__/fixtures/fake-claude-bin/claude, which
# exists to SHOUT if ct-next.mjs were to run `claude` on its own (it does not,
# and that contract still stands). This other one is run by the simulated shell
# of the cmux stub — which is exactly who runs it in real life — so here the
# right thing is to exit silently and successfully: the agent started.
#
# It prints nothing on purpose: its output would go to the same stdout/stderr
# the tests inspect in order to judge ct-next.mjs's messages.
#
# F20/H1 — FAKE_CMUX_CLAUDE_RUNS_FILE: one `X` per invocation. Ever since
# /ct-next RESENDS the line when the sentinel does not appear, "it started" is
# no longer enough: it has to be provable that it started ONCE. Without this
# counter, a double launch onto the same worktree —two agents stepping on each
# other— would pass for a perfect dispatch in every test.
if [ -n "$FAKE_CMUX_CLAUDE_RUNS_FILE" ]; then
  printf 'X' >> "$FAKE_CMUX_CLAUDE_RUNS_FILE"
fi
exit 0
