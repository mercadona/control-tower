#!/usr/bin/env node
// Stub of `osascript` for the `CT_GO_CHANNEL=notify` channel (F38): it records
// its argv and shows nothing. Without it, a test of that channel would fire a
// real notification on the machine of whoever runs the suite — and, worse, an
// environment with no GUI would make it fail and the test would be measuring
// the fallback path. FAKE_OSASCRIPT_FAIL simulates exactly that environment,
// which is the other case to test.
import { appendFileSync } from 'node:fs'
if (process.env.FAKE_OSASCRIPT_LOG) {
  appendFileSync(process.env.FAKE_OSASCRIPT_LOG, JSON.stringify(process.argv.slice(2)) + '\n')
}
if (process.env.FAKE_OSASCRIPT_FAIL) {
  process.stderr.write('fake-osascript: no hay GUI (simulado)\n')
  process.exitCode = 1
}
