#!/usr/bin/env node
// A `cmux` stub for ct-next.mjs's tests: it NEVER launches a real workspace.
// FAKE_CMUX_FAIL makes every `new-workspace` invocation fail;
// FAKE_CMUX_FAIL_NAME_SUBSTR makes only the invocation whose `--name` contains
// that substring fail (for the test of "it fails halfway through the loop with
// several slices selected").
//
// Finding 2 (staleness) and finding 3 (launch verification) add two READ-ONLY
// queries — `list-windows --json` and `workspace list --window <id> --json` —
// that ct-next.mjs uses to (a) check whether there is a live session for an
// in-flight issue, and (b) check, AFTER `new-workspace` has already returned
// success, whether the just-created session really is in the cwd that was
// asked for. Neither of the two launches anything.
//
// So that finding 3 is really checkable (and so that the EXISTING tests of
// "a successful launch" — written before this verification existed — keep
// seeing "lanzado #N" without having to touch each one of them), this stub is
// STATEFUL: every `new-workspace` that does NOT fail records its
// `--name`/`--cwd` in a state file, and `workspace list --json` reads it back.
// The state file, if it is not set explicitly with FAKE_CMUX_STATE_FILE, is
// derived from FAKE_GIT_TOPLEVEL (which EVERY ct-next.mjs test already sets to
// a per-test isolated temporary directory) — so isolation between tests is
// automatic, without having to add a new variable to the 654 pre-existing
// tests.
import { readFileSync, writeFileSync, existsSync, appendFileSync } from 'node:fs'
import { spawnSync } from 'node:child_process'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'
import { waitForReleaseFile } from '../stub-wait.js'

// `shellBin` lives right at the TOP (F20/H1) and not next to runTypedCommand:
// the `send-key` path uses it, and that path runs BEFORE the declarations of
// the `new-workspace` block — a `const` declared further down would fall into
// its temporal dead zone and the stub would die with a ReferenceError that
// would look like a failure of the code under test.
const here = dirname(fileURLToPath(import.meta.url))
const shellBin = join(here, '..', 'fake-cmux-shell-bin')

const argv = process.argv.slice(2)

// FAKE_CMUX_INVOKED_LOG_FILE: records ANY invocation of this stub (subcommand
// + argv), so that a test can check that cmux was NEVER invoked at all — e.g.
// CT_NEXT_FIXTURE, which promises to touch nothing real, not even read-only
// (see the `if (fx) return null` guard in queryAllCmuxWorkspaces,
// ct-next.mjs).
if (process.env.FAKE_CMUX_INVOKED_LOG_FILE) {
  appendFileSync(process.env.FAKE_CMUX_INVOKED_LOG_FILE, argv.join(' ') + '\n')
}

function stateFilePath() {
  if (process.env.FAKE_CMUX_STATE_FILE) return process.env.FAKE_CMUX_STATE_FILE
  if (process.env.FAKE_GIT_TOPLEVEL) return join(process.env.FAKE_GIT_TOPLEVEL, '.fake-cmux-workspaces.json')
  return null
}

function readState() {
  const f = stateFilePath()
  if (!f || !existsSync(f)) return []
  try {
    return JSON.parse(readFileSync(f, 'utf8'))
  } catch {
    return []
  }
}

function appendState(entry) {
  const f = stateFilePath()
  if (!f) return // no state file available: a no-op, the same behaviour as before finding 3.
  const cur = readState()
  cur.push(entry)
  writeFileSync(f, JSON.stringify(cur))
}

// The `ref`s `workspace list` emits number the test's static sessions FIRST
// (FAKE_CMUX_WORKSPACE_TITLES_JSON) and the really launched ones afterwards, so
// translating a `--workspace workspace:<i>` into its state entry demands
// discounting that offset. The arithmetic lives HERE and not in each
// subcommand: `send`/`send-key` and `close-workspace` did it separately, and
// two copies of the same arithmetic send the command to the wrong session as
// soon as one of them is adjusted without the other.
function sessionIndexFor(ws) {
  const staticCount = process.env.FAKE_CMUX_WORKSPACE_TITLES_JSON ? JSON.parse(process.env.FAKE_CMUX_WORKSPACE_TITLES_JSON).length : 0
  const refNum = ws && ws.startsWith('workspace:') ? Number(ws.slice('workspace:'.length)) : NaN
  return Number.isInteger(refNum) ? refNum - staticCount : NaN
}

if (argv[0] === 'list-windows' && argv.includes('--json')) {
  if (process.env.FAKE_CMUX_LIST_WINDOWS_FAIL) {
    console.error('fake-cmux: list-windows failed (simulado, daemon no disponible)')
    process.exit(1)
  }
  process.stdout.write(process.env.FAKE_CMUX_WINDOWS_JSON || JSON.stringify([{ id: 'win1' }]))
  process.exit(0)
}

if (argv[0] === 'workspace' && argv[1] === 'list' && argv.includes('--json')) {
  // FAKE_CMUX_WORKSPACE_TITLES_JSON (finding 2): PRE-EXISTING sessions a test
  // wants to simulate without having "launched" them in this very run (e.g.
  // "there is a session of another slice already open"). They are combined
  // with whatever the process under test really launched in this run (the
  // stateful state above) — neither of the two sources tramples the other.
  const staticTitles = process.env.FAKE_CMUX_WORKSPACE_TITLES_JSON ? JSON.parse(process.env.FAKE_CMUX_WORKSPACE_TITLES_JSON) : []
  const launched = readState()
  // FAKE_CMUX_SCHEMA_MISMATCH (finding 2/3, an adversarial attack from an
  // external review): simulates a version of cmux that renamed the field (e.g.
  // `title` instead of `custom_title`) — there really are entries, but NONE of
  // them with the field name ct-next.mjs expects. It serves to prove that this
  // is treated as INCONCLUSIVE (queryAllCmuxWorkspaces returns null), never as
  // "confirmed: zero sessions", which would be a noisy false positive on every
  // dispatch.
  if (process.env.FAKE_CMUX_SCHEMA_MISMATCH) {
    const workspaces = [...staticTitles, ...launched.map((e) => e.title)].map((t) => ({ title: t, cwd: null }))
    process.stdout.write(JSON.stringify({ workspaces }))
    process.exit(0)
  }
  // FAKE_CMUX_CWD_FIELD_RENAMED (D5, finding B): simulates a version of cmux
  // that renamed ONLY the directory field (`cwd` instead of
  // `current_directory`) and keeps `custom_title`. It is the case the previous
  // schema guard did NOT cover: the title is recognised (so
  // `sawAnyRecognizedTitle` saves nothing), but every `current_directory` comes
  // out `undefined` and, with the strict comparison of before, EVERY correct
  // launch was classified as 'wrong-cwd' — a false alarm on every dispatch, and
  // with an exit-code consequence (0 → 3).
  if (process.env.FAKE_CMUX_CWD_FIELD_RENAMED) {
    const workspaces = [
      ...staticTitles.map((t) => ({ custom_title: t, cwd: null })),
      ...launched.map((e) => ({ custom_title: e.title, cwd: e.cwd })),
    ]
    process.stdout.write(JSON.stringify({ workspaces }))
    process.exit(0)
  }
  // F20/H1: `ref` is the handle `cmux send --workspace` accepts, and the one
  // ct-next.mjs needs in order to be able to FORWARD the line to one concrete
  // session. The real cmux returns it as "workspace:<n>" (verified against the
  // development machine's `cmux workspace list --json`).
  // FAKE_CMUX_NO_REF simulates a version that does not expose it: the forward
  // cannot be aimed anywhere, and that CANNOT happen in silence.
  const withRef = (i) => (process.env.FAKE_CMUX_NO_REF ? {} : { ref: `workspace:${i}` })
  const workspaces = [
    ...staticTitles.map((t, i) => ({ custom_title: t, current_directory: null, ...withRef(i) })),
    ...launched.map((e, i) => ({ custom_title: e.title, current_directory: e.cwd, ...withRef(staticTitles.length + i) })),
  ]
  process.stdout.write(JSON.stringify({ workspaces }))
  process.exit(0)
}

// F20/harvest — `close-workspace`: the real cmux closes the workspace and with
// it the `claude` that lived inside. Here it is simulated by removing its entry
// from the state, which is what makes a later `workspace list` no longer see
// it: without that, a test could not tell "it was closed" from "closing it was
// asked for". The invocation was already recorded above in
// FAKE_CMUX_INVOKED_LOG_FILE.
// FAKE_CMUX_CLOSE_FAIL simulates the close failing (daemon down, session
// locked) WITHOUT touching the state: it is the case that leaves the harvest
// half-done.
if (argv[0] === 'close-workspace') {
  if (process.env.FAKE_CMUX_CLOSE_FAIL) {
    console.error('fake-cmux: close-workspace failed (simulado)')
    process.exit(1)
  }
  const wsIdx = argv.indexOf('--workspace')
  const ws = wsIdx !== -1 ? argv[wsIdx + 1] : null
  const idx = sessionIndexFor(ws)
  const state = readState()
  const entry = Number.isInteger(idx) && idx >= 0 ? state[idx] : null
  if (!entry || !stateFilePath()) {
    console.error(`fake-cmux: close-workspace: no hay ninguna sesión ${ws}`)
    process.exit(1)
  }
  state.splice(idx, 1)
  writeFileSync(stateFilePath(), JSON.stringify(state))
  process.exit(0)
}

// ===========================================================================
// F20/H1 — `send` / `send-key`: FORWARDING the line.
//
// The real cmux executes nothing with `send`: it writes the text into the
// shell's edit line (measured: after a bare `send` the text just sits there
// unexecuted) and a separate `send-key Enter` is needed. This stub reproduces
// that separation: `send` stores the session's pending text, `send-key Enter`
// is what executes it. If a future change stopped sending the Enter, this stub
// would execute NOTHING and the test would see it.
if (argv[0] === 'send' || argv[0] === 'send-key') {
  const wsIdx = argv.indexOf('--workspace')
  const ws = wsIdx !== -1 ? argv[wsIdx + 1] : null
  const idx = sessionIndexFor(ws)
  const state = readState()
  const entry = Number.isInteger(idx) && idx >= 0 ? state[idx] : null
  if (!entry || !stateFilePath()) {
    console.error(`fake-cmux: ${argv[0]}: no hay ninguna sesión ${ws}`)
    process.exit(1)
  }
  if (process.env.FAKE_CMUX_SEND_FAIL) {
    console.error('fake-cmux: send failed (simulado)')
    process.exit(1)
  }
  if (argv[0] === 'send') {
    entry.pending = argv[argv.length - 1]
    writeFileSync(stateFilePath(), JSON.stringify(state))
    process.exit(0)
  }
  const key = argv[argv.length - 1]
  if (key === 'Enter' && typeof entry.pending === 'string') {
    const text = entry.pending
    entry.pending = null
    writeFileSync(stateFilePath(), JSON.stringify(state))
    // A forward is eaten by NOBODY: the shell's rc has finished starting up.
    // FAKE_CMUX_EAT_ALWAYS_SUBSTR is the deliberate exception (an rc that
    // devours EVERYTHING typed), so that it can be proved that the dispatcher
    // still does not lie when not even the forwards are enough.
    runTypedCommandIn(text, entry, !!(process.env.FAKE_CMUX_EAT_ALWAYS_SUBSTR && entry.title.includes(process.env.FAKE_CMUX_EAT_ALWAYS_SUBSTR)))
  }
  process.exit(0)
}

// `new-workspace` (the only path that would really launch something real — it
// is never invoked from the staleness/verification tests on their own, only
// from the real dispatch ones, and always against this stub).
const nameIdx = argv.indexOf('--name')
const name = nameIdx !== -1 ? argv[nameIdx + 1] : ''
const cwdIdx = argv.indexOf('--cwd')
const cwd = cwdIdx !== -1 ? argv[cwdIdx + 1] : null
const commandIdx = argv.indexOf('--command')
const command = commandIdx !== -1 ? argv[commandIdx + 1] : null

// ===========================================================================
// F19/H1 — THE STUB NOW SIMULATES WHAT `--command` REALLY DOES.
//
// The help of the cmux installed on this machine (read with `strings` over the
// binary, never executing it) says, for `new-workspace`:
//
//     --command <text>     Send text+Enter to the new workspace after creation
//
// It is not an exec: they are KEYSTROKES sent to an interactive login shell.
// Until F19 this stub ignored `--command` altogether, so the WHOLE suite
// checked the dispatch without the command ever being executed — the same blind
// spot that let the field finding through (an open window counted as a launched
// agent). Now the stub executes the text with `sh -c` in the `--cwd` that was
// asked for, which is the part of the real semantics that matters here: the
// command runs, in that directory, in a shell.
//
// What is NOT simulated (and it is said so as not to sell more than this is):
// there is no pty, no user rc, no asynchrony — the command runs synchronously
// inside `new-workspace`. What CAN be simulated, and is what was needed, is the
// text arriving CORRUPTED or not arriving at all.
//
//   FAKE_CMUX_EAT_FIRST_CHAR_SUBSTR — reproduces the exact finding: oh-my-zsh's
//     prompt eats the first character and `. /tmp/…` comes in as ` /tmp/…`. The
//     shell fails, the sentinel is not written, and cmux returns 0 all the same
//     because `new-workspace` had already finished its job.
//   FAKE_CMUX_SKIP_COMMAND_SUBSTR — the text does not arrive at all.
//   FAKE_CMUX_NO_CLAUDE_IN_SHELL — the command runs, but in a shell where
//     `claude` is not on the PATH (the case ct-next.mjs's preflight could only
//     suspect, because it looks at ITS own PATH and not at that of the login
//     shell cmux opens).
//
// The `claude` that simulated shell sees is a SILENT stub of its own
// (fake-cmux-shell-bin), not fake-claude-bin's: that one exists to shout if
// ct-next.mjs executes `claude` on its own account —something it still does
// not do, and that contract is not being touched— whereas THIS one is the one
// the cmux session would really launch.

//   FAKE_CMUX_COMMAND_CWD — the command runs in ANOTHER directory (the case
//     where cmux tolerates a non-existent `--cwd` and starts up in the default
//     login shell). Here what lies is not cmux: it is reality, and the
//     sentinel's `$PWD` is what gives it away.
//   FAKE_CMUX_COMMAND_DELAY_MS — the command runs IN THE BACKGROUND after that
//     delay, so that "the sentinel has not appeared YET" can be told apart from
//     "it is not going to appear". It is the only one of these variables that
//     makes the stub asynchronous, and it exists precisely because that
//     distinction is temporal and cannot be tested in any other way.
//
// F20/H1 — the forward forced separating "in which session" from the stub's
// global state: `send-key Enter` runs BEFORE any `--name`/`--cwd` is parsed
// (that parsing belongs to the `new-workspace` path), so the target session
// travels as an explicit argument. `runTypedCommand` keeps its signature so as
// not to touch the `new-workspace` path.
//
// And the `eat` now applies ONLY to the first typing, which is what oh-my-zsh's
// prompt really does: it eats one character once, and by the time the forward
// arrives the rc has finished starting up. Measured against the real cmux: with
// a forward, 5 out of 5 launches started up on the second attempt.
function runTypedCommandIn(text, session, eatFirstChar = false) {
  if (text === null || text === undefined) return
  const sessionName = (session && session.title) || ''
  const sessionCwd = (session && session.cwd) || null
  const skip = process.env.FAKE_CMUX_SKIP_COMMAND_SUBSTR
  if (skip && sessionName.includes(skip)) return
  const typed = eatFirstChar ? text.slice(1) : text
  // The simulated shell's PATH: the silent `claude` first (unless the test asks
  // for it not to exist), and nothing else from the test's environment that
  // could confuse things.
  const path = process.env.FAKE_CMUX_NO_CLAUDE_IN_SHELL
    ? '/usr/bin:/bin'
    : `${shellBin}:/usr/bin:/bin`
  const forced = process.env.FAKE_CMUX_COMMAND_CWD
  const runDir = forced || (sessionCwd && existsSync(sessionCwd) ? sessionCwd : process.cwd())
  const delay = Number(process.env.FAKE_CMUX_COMMAND_DELAY_MS || 0)
  // With a delay, it is launched in the background and `new-workspace` returns
  // AT ONCE — just like the real cmux, which does not wait for the shell to do
  // anything.
  const line = delay > 0 ? `( sleep ${delay / 1000} ; ${typed} ) >/dev/null 2>&1 &` : typed
  spawnSync('/bin/sh', ['-c', line], {
    cwd: existsSync(runDir) ? runDir : process.cwd(),
    env: { ...process.env, PATH: path },
    stdio: 'ignore',
  })
}

// The first typing —the `--command` one— is the ONLY one
// FAKE_CMUX_EAT_FIRST_CHAR_SUBSTR is applied to, and that is the FAITHFUL
// simulation: oh-my-zsh's prompt eats one character ONCE, during the rc's
// start-up; by the time a forward arrives, the rc has finished. Applying it to
// the forward as well would have the stub test a shell that does not exist —
// and would hide exactly the property F20 measured live (5 out of 5 start up on
// the second attempt).
function runTypedCommand(text) {
  const eat = process.env.FAKE_CMUX_EAT_FIRST_CHAR_SUBSTR
  runTypedCommandIn(text, { title: name, cwd }, !!(eat && name.includes(eat)))
}

// FAKE_CMUX_NEW_WORKSPACE_WAIT_FILE (F8): it stays INSIDE the `new-workspace`
// until the test creates the sentinel file. The invocation was already recorded
// above in FAKE_CMUX_INVOKED_LOG_FILE (synchronously), so the test can detect
// by file that ct-next is blocked inside this call and send it a signal without
// depending on hitting a time window. See __tests__/fixtures/stub-wait.js.
waitForReleaseFile('FAKE_CMUX_NEW_WORKSPACE_WAIT_FILE')

if (process.env.FAKE_CMUX_FAIL) {
  console.error('fake-cmux: new-workspace failed (simulado)')
  process.exit(1)
}
if (process.env.FAKE_CMUX_FAIL_NAME_SUBSTR && name.includes(process.env.FAKE_CMUX_FAIL_NAME_SUBSTR)) {
  console.error('fake-cmux: new-workspace failed (simulado, por nombre)')
  process.exit(1)
}
// FAKE_CMUX_WRONG_CWD_SUBSTR (finding 3): simulates the finding's exact
// scenario — cmux "accepts" the launch (exit 0) but the session ends up in
// another directory (a non-existent cwd, the default login shell). It only
// affects the state RECORD (what `workspace list` sees afterwards), never
// `new-workspace`'s exit code — that is precisely what makes the scenario real:
// cmux warns about nothing.
if (process.env.FAKE_CMUX_WRONG_CWD_SUBSTR && name.includes(process.env.FAKE_CMUX_WRONG_CWD_SUBSTR)) {
  // The command IS executed, and in the right cwd: what this scenario
  // simulates is cmux REPORTING another directory for its window. They are two
  // different sources (the shell's `$PWD` vs. cmux's `current_directory`) and
  // the discrepancy between them is exactly what this case exercises.
  runTypedCommand(command)
  appendState({ title: name, cwd: '/Users/fake/.config/ghostty-default-shell-dir' })
  process.exit(0)
}
// FAKE_CMUX_SKIP_STATE_SUBSTR (finding 3): simulates "cmux said success but the
// session does not show up when queried" — no state write at all for this one
// launch, even though the exit code is still 0.
if (process.env.FAKE_CMUX_SKIP_STATE_SUBSTR && name.includes(process.env.FAKE_CMUX_SKIP_STATE_SUBSTR)) {
  runTypedCommand(command)
  process.exit(0)
}
runTypedCommand(command)
appendState({ title: name, cwd })
process.exit(0)
