node_modules/

# Ephemeral output of the live-experiment harnesses (plugin/scripts/experiments/*.sh):
# they never run in CI/npm test, and their results must not be versioned.
plugin/scripts/experiments/*-results/


# Scratch of the subagent-driven process (ledger, briefs, reports, review packages).
# Ephemeral by definition: the durable record is git history.
.superpowers/

# Session worktrees the harness creates inside the checkout itself. Without this
# line, a `git add -A` in the main checkout swallows a whole nested working tree —
# the same accident `.worktrees/` already covers for the slice worktrees (see the
# .worktrees/ block in scripts/ct-init.sh). ONLY the subdirectory is ignored:
# `.claude/` also holds configuration that does get versioned.
.claude/worktrees/

# Finder junk. It shows up on its own when any folder of the repo is opened on
# macOS and dirties `git status` in every session — two of them were living
# untracked at the same time this was being written.
.DS_Store
.worktrees/
.agent/SLICE.md
.agent/run-*.json
.agent/run-*/
