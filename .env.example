# Copy to .env, which git ignores, and fill in your own values.
# Make reads this file verbatim: no quotes, no spaces around the `=`.

# The API port. 0 asks the operating system for an ephemeral one.
CT_API_PORT=8787

# An absolute path, if you keep Claude Code's config somewhere else.
# CLAUDE_CONFIG_DIR=/absolute/path/to/.claude

# Optional absolute root for CT records, checkout registry and machine logs.
# Does not move Claude Code's account, settings or conversation transcripts.
# CT_STATE_DIR=/absolute/path/to/control-tower-state

# Shape project:dataset.table. Unset keeps metrics delivery off.
# Never a real project, dataset or table name: this repository is public.
# CT_HARVEST_BQ_TABLE=my-project:my_dataset.my_table
